@using BunlyWebUI.Dtos.FeatureDtos

@model List<ResultFeatureDto>
@{
    ViewData["Title"] = "FeatureList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}


<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Öne Çıkan Alan Listesi</h4>
                    </div>
                    
                    <div class="card-body">
                        <p class="text-muted mb-0">Tema bütünlüğünün bozulmaması adına sadece 1 tane öne çıkan alan  bilgisi eklenmelidir.</p>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Başlık</th>
                                    <th scope="col">Alt Başlık</th>
                                    <th scope="col">Açıklama</th>
                                    <th scope="col">Sil</th>
                                    <th scope="col">Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <th scope="row">@count</th>
                                        <td>@item.Title</td>
                                        <td>@item.SubTitle</td>
                                        <td>@item.Description</td>
                                        <td>  <a href="/Feature/DeleteFeature?id=@item.FeatureId" class="btn btn-danger">Sil</a></td>
                                        <td><a href="/Feature/UpdateFeature/@item.FeatureId" class="btn btn-success">Güncelle</a></td>
                                     
                                    </tr>
                                }
                               
                            </tbody>
                        </table>

                        @if (Model.Count < 1)
                        {
                            <td><a class="btn btn-success" href="/Feature/CreateFeature">Yeni Öne Çıkan Alan Girişi</a></td>
                        }
                        else
                        {
                            <td><a class="btn btn-primary" href="#"> Öne Çıkan Alan Mevcut</a></td>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



