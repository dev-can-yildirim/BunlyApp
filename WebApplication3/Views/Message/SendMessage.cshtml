@model CreateMessageDto
<style>
 
    .contact-form input,
    .contact-form textarea {
        border-radius: 6px;
        border: 1px solid #ddd;
        padding: 12px 14px;
        font-size: 14px;
    }

    .contact-form textarea {
        min-height: 160px;
    }

    .contact-form button[type="submit"] {
        background: #ce1212;
        color: #fff;
        border: none;
        padding: 12px 36px;
        border-radius: 50px;
        font-size: 15px;
        font-weight: 500;
        transition: 0.3s;
    }

        .contact-form button[type="submit"]:hover {
            background: #ec2727;
        }
</style>
<form asp-action="SendMessage" asp-controller="Message" method="post" class="contact-form" data-aos="fade-up" data-aos-delay="600">
    <div class="row gy-4 mt-4">

        <div class="col-md-6">
            <input type="text" asp-for="NameSurname" class="form-control" placeholder="Adınız Soyadınız" required>
        </div>

        <div class="col-md-6">
            <input type="email" asp-for="Email" class="form-control" placeholder="Email adresiniz" required>
        </div>

        <div class="col-md-12">
            <input type="text" asp-for="Subject" class="form-control" placeholder="Konu" required>
        </div>

        <div class="col-md-12">
            <textarea asp-for="MessageDetails" class="form-control" rows="6" placeholder="Mesajınız" required></textarea>
        </div>

        <div class="col-md-12 text-center">
            <button type="submit">Mesaj Gönder</button>
        </div>

    </div>
</form>