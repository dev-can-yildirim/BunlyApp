@model List<ResultEventDto>

@{
    ViewData["Title"] = "BunlyEventList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Etkinlik Listesi</h4>
                    </div>
                    <div class="card-body">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Etkinlik Adı</th>
                                    <th scope="col">Etkinlik Ücreti</th>
                                    <th scope="col">Etkinlik Resim Yolu</th>
                                    <th scope="col">Etkinlik Açıklaması</th>
                                    <th scope="col">Sil</th>
                                    <th scope="col">Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <th scope="row">@count</th>
                                        <td>@item.Title</td>
                                        <td>@item.Price</td>
                                        <td>@item.ImageUrl</td>
                                        <td>@item.Description</td>
                                        <td><a href="/BunlyEvent/DeleteBunlyEvent/@item.BunlyEventId" class="btn btn-danger">Sil</a></td>
                                        <td><a href="/BunlyEvent/UpdateBunlyEvent/@item.BunlyEventId" class="btn btn-success">Güncelle</a></td>
                                     
                                    </tr>
                                }
                               
                            </tbody>
                        </table>
                        <td><a class="btn btn-success" href="/BunlyEvent/CreateBunlyEvent">Yeni Etkinlik Girişi</a></td>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



