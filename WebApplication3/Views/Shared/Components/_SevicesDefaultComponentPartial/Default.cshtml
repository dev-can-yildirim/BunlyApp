@using BunlyWebUI.Dtos.ServiceDtos

@model List<ResultServiceDto>

<!-- Neden Biz Section -->
<section id="why-us" class="why-us section light-background">

    <div class="container">

        <div class="row gy-4">

            <div class="col-lg-4" data-aos="fade-up" data-aos-delay="100">
                <div class="why-box">
                    <h3>Neden Bunly?</h3>
                    <p>
                        Bunly olarak lezzeti, kaliteyi ve samimi hizmet anlayışını bir araya getiriyoruz.
                        Taze malzemelerle hazırlanan yemeklerimiz, özenli sunumlarımız ve sıcak atmosferimizle
                        misafirlerimize keyifli bir deneyim yaşatmayı hedefliyoruz.
                    </p>
                    <div class="text-center">
                        <a href="#" class="more-btn"><span>Daha Fazla Bilgi</span> <i class="bi bi-chevron-right"></i></a>
                    </div>
                </div>
            </div><!-- End Why Box -->

            <div class="col-lg-8 d-flex align-items-stretch">
                <div class="row gy-4" data-aos="fade-up" data-aos-delay="200">

                    @foreach (var item in Model)
                    {
                        <div class="col-xl-4">
                            <div class="icon-box d-flex flex-column justify-content-center align-items-center">
                                <i class="@item.IconUrl"></i>
                                <h4>@item.Title</h4>
                                <p>@item.Description</p>
                            </div>
                        </div>
                    }

                </div>
            </div>

        </div>

    </div>

</section><!-- /Neden Biz Section -->
