@model List<ResultAboutDto>

@{
    ViewData["Title"] = "AboutList";
    Layout = "~/Views/AdminLayout/Index.cshtml"; int count = 0;
}


<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Hakkımızda Listesi</h4>
                    </div>
                    <div class="card-body">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Başlık</th>
                                    <th scope="col">Açıklama</th>
                                    <th scope="col">Resim Yolu</th>
                                    <th scope="col">Video Yolu</th>
                                    <th scope="col">Video Resmi Yolu</th>
                                    <th scope="col">Rezervazyon Numarası</th>
                                    <th scope="col">Sil</th>
                                    <th scope="col">Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <th scope="row">@count</th>
                                        <td>@item.Title</td>
                                        <td>@item.Description</td>
                                        <td>@item.ImageUrl</td>
                                        <td>@item.VideoUrl</td>
                                        <td>@item.VideoCoverImageUrl</td>
                                        <td>@item.ReservationNumber</td>
                                        <td><a href="/About/DeleteAbout/@item.AboutId" class="btn btn-danger">Sil</a></td>
                                        <td><a href="/About/UpdateAbout/@item.AboutId" class="btn btn-success">Güncelle</a></td>
                                     
                                    </tr>
                                }
                               
                            </tbody>
                        </table>
                        @if (Model.Count >= 1)
                        {
                            <td><a class="btn btn-primary" href="#">Hakkımızda bölümü zaten var</a></td>
                            
                        }
                        else
                        {
                            <td><a class="btn btn-success" href="/About/CreateAbout">Yeni Hakkımızda Bölümü Oluştur</a></td>
                            
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



