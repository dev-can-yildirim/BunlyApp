@model List<ResultContactDto>
@{
    ViewData["Title"] = "ContactList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}


<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>İletişim Alanı</h4>
                    </div>
                    <div class="card-body">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">İletişim Adresi</th>
                                    <th scope="col">Mail Adresi</th>
                                    <th scope="col">Konum</th>
                                    <th scope="col">Açılış Saati</th>
                                    <th scope="col">Telefon Numarası</th>
                                    <th scope="col">Sil</th>
                                    <th scope="col">Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <th scope="row">@count</th>
                                        <td>@item.Address</td>
                                        <td>@item.Email</td>
                                        <td>@item.MapLocation</td>
                                        <td>@item.OpenHours</td>
                                        <td>@item.PhoneNumber</td>
                                        <td><a href="/Contact/DeleteContact/@item.ContactId" class="btn btn-danger">Sil</a></td>
                                        <td><a href="/Contact/UpdateContact/@item.ContactId" class="btn btn-success">Güncelle</a></td>
                                     
                                    </tr>
                                }

                                
                            </tbody>
                        </table>
                        @if (count < 1)
                        {
                            <td><a class="btn btn-success" href="/Contact/CreateContact">Yeni İletişim Alanı</a></td>
                        }
                        else
                        {
                            <td><a class="btn btn-primary" href="#">İletişim Alanı Mevcut</a></td>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


